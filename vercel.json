{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 scripts/build.py",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    {"source": "/:path*", "has": [{"type": "host", "value": "corkageclub.org"}], "destination": "https://www.corkageclub.org/:path*", "permanent": true},
    {"source": "/:path*", "has": [{"type": "host", "value": "corkage.vercel.app"}], "destination": "https://www.corkageclub.org/:path*", "permanent": true},
    {"source": "/index.html", "destination": "/", "permanent": true}
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
      {"key": "X-Frame-Options", "value": "DENY"},
      {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"}
    ]}
  ]
}
